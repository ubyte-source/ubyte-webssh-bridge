# Every variable ubyte-webssh-bridge reads, with its default; README.md describes each.
# A flag on the command line wins over its variable, and a variable over the default.
# Copy it to bridge.env (git ignores *.env), uncomment what you set, and pass it with
# docker run --env-file bridge.env or export it with set -a; . ./bridge.env; set +a.
# An unknown UWSB_ name is logged at warn on startup and ignored.

# Server
# UWSB_SERVER_ADDRESS=:8443
# UWSB_SERVER_CERT=/data/certificate.crt
# UWSB_SERVER_KEY=/data/certificate.key
# UWSB_SERVER_DEBUG=false
# UWSB_SERVER_SHUTDOWN_TIMEOUT=30s
# UWSB_SERVER_TRUSTED_PROXIES=127.0.0.0/8,::1/128

# Sessions
# UWSB_CONN_MAX_TOTAL=1000
# UWSB_CONN_MAX_PER_HOST=10
# UWSB_RATE_BURST=10
# UWSB_RATE_INTERVAL=2s

# SSH; beyond loopback the bridge needs a target
# UWSB_SSH_TARGET=
# UWSB_SSH_CONNECT_TIMEOUT=10s
# UWSB_SSH_LOGIN_TIMEOUT=120s

# WebSocket
# UWSB_WS_HANDSHAKE_TIMEOUT=10s
